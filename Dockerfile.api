# FastAPI trigger + mission executor.
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libxml2 libxslt1.1 \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY flight_core /app/flight_core
COPY trigger_api /app/trigger_api

ENV PYTHONUNBUFFERED=1 \
    MAVLINK_CONNECTION=tcp:sitl:5760 \
    API_HOST=0.0.0.0 \
    API_PORT=8000

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "trigger_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
