[Unit]
Description=VanniKawachh Pixhawk flight API (read-only setup, dispatch locked)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/vannikawachh-flight
Environment=MAVLINK_CONNECTION=/dev/serial0
Environment=MAVLINK_BAUD=57600
Environment=ALLOW_REAL_DISPATCH=0
Environment=HOME_LAT=0
Environment=HOME_LON=0
Environment=LOG_DIR=%h/vannikawachh-flight/logs
ExecStart=%h/vannikawachh/.venv/bin/python -m uvicorn trigger_api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
