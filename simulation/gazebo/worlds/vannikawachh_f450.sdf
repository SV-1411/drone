<?xml version='1.0'?>
<sdf version='1.9'>
  <world name='vannikawachh_f450_world'>
    <gravity>0 0 -9.81</gravity>
    <physics name='1ms' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename='gz-sim-physics-system' name='gz::sim::systems::Physics'/>
    <!-- Required for the generated F450 IMU (and its retained camera/GPS sensors). -->
    <plugin filename='gz-sim-sensors-system' name='gz::sim::systems::Sensors'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename='gz-sim-imu-system' name='gz::sim::systems::Imu'/>
    <plugin filename='gz-sim-navsat-system' name='gz::sim::systems::NavSat'/>
    <plugin filename='gz-sim-user-commands-system' name='gz::sim::systems::UserCommands'/>
    <plugin filename='gz-sim-scene-broadcaster-system' name='gz::sim::systems::SceneBroadcaster'/>
    <plugin filename='gz-sim-contact-system' name='gz::sim::systems::Contact'/>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.72 0.82 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <light name='sun' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
    </light>

    <model name='ground'>
      <static>true</static>
      <link name='ground_link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>10000 10000</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>10000 10000</size></plane></geometry>
          <material>
            <ambient>0.24 0.33 0.18 1</ambient>
            <diffuse>0.30 0.42 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='home_pad'>
      <static>true</static>
      <pose>0 0 0.03 0 0 0</pose>
      <link name='pad_link'>
        <collision name='collision'><geometry><cylinder><radius>4</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name='visual'>
          <geometry><cylinder><radius>4</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.05 0.18 0.22 1</ambient><diffuse>0.08 0.30 0.36 1</diffuse></material>
        </visual>
      </link>
      <link name='ring_link'>
        <pose>0 0 0.04 0 0 0</pose>
        <visual name='ring'>
          <geometry><cylinder><radius>3.2</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.02 0.95 0.72 1</ambient><diffuse>0.02 0.95 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name='runway'>
      <static>true</static>
      <pose>0 60 0.015 0 0 0</pose>
      <link name='runway_link'>
        <collision name='collision'><geometry><box><size>18 120 0.03</size></box></geometry></collision>
        <visual name='visual'>
          <geometry><box><size>18 120 0.03</size></box></geometry>
          <material><ambient>0.13 0.13 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Launch the F450 at the center of the pad. The adapter-created model is
         the actual moving aircraft and supplies the ArduPilot/Gazebo interface. -->
    <include>
      <uri>model://vannikawachh_f450</uri>
      <name>vannikawachh_f450</name>
      <pose>0 0 0.35 0 0 0</pose>
    </include>
  </world>
</sdf>
